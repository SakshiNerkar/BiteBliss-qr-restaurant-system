                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"adminName\": \"John Doe\",\n    \"restaurantName\": \"Pizza Palace\",\n    \"email\": \"admin@pizzapalace.com\",\n    \"password\": \"123456\",\n    \"phone\": \"123-456-7890\",\n    \"address\": \"123 Main St\"\n}"
